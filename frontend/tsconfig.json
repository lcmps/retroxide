{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"rewriteRelativeImportExtensions": true,
		"sourceMap": true,
		"strict": true
	},
	"include": ["src", "test", "*"],
	"exclude": ["src/service-worker"]
	// SvelteKit generates the base config into node_modules/$app/tsconfig.json on `svelte-kit sync`.
	// `#lib` is declared in package.json `imports`: https://svelte.dev/docs/kit/$lib
}
